bindings (
    // Core editing
    {keys s,       action 40757, desc "Split items at cursor"}
    {keys d,       action 40006, desc "Delete selected items"}

    // Smart duplicate — copy selection forward by its own measure span
    // (group + color preserving, tempo-aware). Replaces stock "Duplicate
    // items" (41295) on Ctrl+D.
    {keys "<C-d>",  action "_FTS_SMART_DUPLICATE", desc "Smart duplicate",
     mnemonic "D for Duplicate",
     why "Ctrl+D duplicates in every editor; the FTS action places the copy a full measure-span later so repeated hits build a section on the grid."}

    // Glue items within the time selection
    {keys "<C-S-g>", action 42432, desc "Glue items within time selection",
     mnemonic "G for Glue",
     why "Ctrl+Shift+G glues the selection's items into one within the time selection."}

    // Expression editor — `e` loads the selected item (audio or MIDI)
    // into the FTS Expression Editor and shows the panel. `E` keeps the
    // stock MIDI editor reachable; inside it, `e`/`E` close it (bound in
    // midi.styx).
    {keys e,       action "FTS_EXPRESSION_EDITOR_OPEN", desc "Open selected item in Expression Editor"}
    {keys "<S-e>", action 40153, desc "Open selected item in MIDI editor"}
    {keys "<delete>",     action 40697, desc "Delete"}
    {keys "<backspace>",  action 40697, desc "Delete"}
    {keys "<escape>",     action 40020, desc "Remove time selection and loop points"}

    // Standard edit shortcuts
    {keys "<C-x>",   action 40059, desc "Cut items/tracks/envelope points"}
    {keys "<C-c>",   action 40698, desc "Copy items"}
    {keys "<C-v>",   action 42398, desc "Paste items/tracks"}
    {keys "<C-a>",   action 40035, desc "Select all items/tracks/envelope points"}

    // Single-key editing
    {keys x,       action 40059, desc "Cut selected items"}
    {keys c,       action 1068, desc "Transport: toggle repeat"}
    {keys p,       action 40058, desc "Paste items"}

    // Edit options
    {keys "<A-s>",   action 1157, desc "Toggle snapping"}

    // Undo/redo
    {keys u,       action 40029, desc "Undo"}
    {keys "<C-z>",   action 40029, desc "Undo"}
    {keys "<M-z>",   action 40029, desc "Undo"}
    {keys "<C-M-z>", action 40072, desc "Show undo history window"}
    {keys "<C-r>",   action 40030, desc "Redo"}
    {keys "<C-S-z>", action 40030, desc "Redo"}

)
