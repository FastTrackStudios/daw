// daw-csi zone definitions — Behringer X-Touch (Mackie Control mode).
//
// CSI's .zon concept, in Styx. A zone binds widgets to actions;
// @GoZone{zone …} moves between zones; `include` inherits another
// zone's bindings (local entries override). Modifier-qualified keys
// (`shift+select`) bind the modified gesture; unmodified bindings are
// the fallback. This file is embedded as the built-in default —
// point FTS_CSI_ZONES at a copy to customize without rebuilding.
//
// Strip widgets:  fader vpot vpot_press rec solo mute select
//                 lcd_top lcd_bottom
// Buttons block:  master_fader jog play stop record rewind
//                 fast_forward cycle bank_left bank_right
//                 channel_left channel_right flip global_view marker
//                 nudge drop replace click solo_global up down left
//                 right zoom scrub f1–f8

@ ./zones.schema.styx

// Boot into folder mode — the band-family view is the home base;
// GLOBAL VIEW hops to the flat track list ("home" zone) and back.
home folder

zones {
    /// Track mode: the flat track list banked across the strips.
    home {
        navigator @Track
        strip {
            fader      @TrackVolume
            vpot       @TrackPan
            vpot_press @TrackPanReset
            rec        @TrackRecordArm
            solo       @TrackSolo
            mute       @TrackMute
            select     @TrackSelect
            lcd_top    @TrackName
            lcd_bottom @PanDisplay
        }
        buttons {
            master_fader  @MasterVolume
            jog           @JogPosition{seconds_per_tick 1}
            play          @Play
            stop          @Stop
            record        @Record
            cycle         @ToggleLoop
            rewind        @NudgePosition{seconds -5}
            fast_forward  @NudgePosition{seconds 5}
            bank_left     @Bank{amount -8}
            bank_right    @Bank{amount 8}
            channel_left  @Bank{amount -1}
            channel_right @Bank{amount 1}
            global_view   @GoZone{zone folder}
            assign_plugin @GoZone{zone fxmenu}
        }
    }

    /// Folder mode: top-level tracks on the strips; SELECT on a
    /// folder spills it (the folder leads its children), SELECT on
    /// the spilled folder pops back up — CSI's ToggleFolderSpill.
    folder {
        include (home)
        navigator @Folder
        strip {
            select     @FolderSpill
            lcd_bottom @FolderIndicator
        }
        buttons {
            global_view @GoZone{zone home}
        }
    }

    /// FX menu: strips show the SELECTED track's FX chain. SELECT
    /// focuses an FX and opens its parameter zone; MUTE bypasses
    /// (LED lit = active).
    fxmenu {
        display_color @Blue
        strip {
            lcd_top @FxMenuNameDisplay
            lcd_bottom @Blank
            select  @FxMenuSelect{zone fx}
            mute    @FxMenuBypass
            rec     @NoAction
            solo    @NoAction
        }
        buttons {
            master_fader  @MasterVolume
            play @Play
            stop @Stop
            record @Record
            cycle @ToggleLoop
            assign_plugin @GoZone{zone home}
            global_view   @GoZone{zone home}
        }
    }

    /// FX params: strips are the focused FX's parameters — v-pot
    /// turns, fader rides, both rows show name/value. CHANNEL </>
    /// pages through plugins with more than 8 parameters.
    fx {
        display_color @Green
        strip {
            fader      @FxParam
            vpot       @FxParam
            lcd_top    @FxParamNameDisplay
            lcd_bottom @FxParamValueDisplay
            mute       @NoAction
            rec        @NoAction
            solo       @NoAction
            select     @NoAction
        }
        buttons {
            master_fader  @MasterVolume
            play @Play
            stop @Stop
            record @Record
            cycle @ToggleLoop
            channel_left  @BankFxParams{amount -1}
            channel_right @BankFxParams{amount 1}
            bank_left     @BankFxParams{amount -8}
            bank_right    @BankFxParams{amount 8}
            assign_plugin @GoZone{zone fxmenu}
            global_view   @GoZone{zone home}
        }
    }
}
