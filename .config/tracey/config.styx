@schema {id crate:tracey-config@1, cli tracey}

specs (
    {
        name example
        source_url https://git.starcommand.live/codywright/architect
        include (features/example/spec/**/*.md)
        impls (
            {
                name rust
                include (
                    features/example/**/*.rs
                )
                exclude (
                    features/example/**/target/**
                )
                test_include (
                    features/example/tests/**/*.rs
                )
            }
        )
    }
)
