@schema {id crate:tracey-config@1, cli tracey}

specs (
    {
        name architect
        source_url https://git.starcommand.live/codywright/architect
        include (docs/content/spec/**/*.md)
        impls (
            {
                name rust
                include (
                    apps/**/*.rs
                    features/**/*.rs
                    macros/**/*.rs
                    xtask/**/*.rs
                )
                exclude (
                    target/**
                )
                test_include (
                    features/**/tests/**/*.rs
                    apps/**/tests/**/*.rs
                )
            }
        )
    }
)
