@schema {id crate:tracey-config@1, cli tracey}

specs (
    {
        name example
        source_url https://git.starcommand.live/codywright/architect
        include (features/example/spec/**/*.md)
        impls (
            {
                name rust
                include (
                    features/example/**/*.rs
                )
                exclude (
                    features/example/**/target/**
                )
                test_include (
                    features/example/tests/**/*.rs
                )
            }
        )
    }


    {
        name foo
        include (features/foo/spec/**/*.md)
        impls (
            {
                name rust
                include (
                    features/foo/**/*.rs
                )
                exclude (
                    features/foo/**/target/**
                )
                test_include (
                    features/foo/tests/**/*.rs
                )
            }
        )
    }

    {
        name bar
        include (features/bar/spec/**/*.md)
        impls (
            {
                name rust
                include (
                    features/bar/**/*.rs
                )
                exclude (
                    features/bar/**/target/**
                )
                test_include (
                    features/bar/tests/**/*.rs
                )
            }
        )
    }
)
